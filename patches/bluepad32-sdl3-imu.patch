+        return false;
+    switch_instance_t* ins = get_switch_instance(d);
+    if (!ins->native_owned || ins->state != STATE_READY || !d->conn.connected ||
+        !d->conn.interrupt_cid || !l2cap_can_send_packet_now(d->conn.interrupt_cid))
+        return false;
+    uint8_t report[11] = {0xa2, OUTPUT_RUMBLE_ONLY, 0};
+    memcpy(&report[3], rumble, 8);
+    return switch_submit_report(d, d->conn.interrupt_cid, report, sizeof(report)) == ERROR_CODE_SUCCESS;
+}
+
+void uni_hid_parser_switch_native_release(uni_hid_device_t* d) {
+    if (!d || d->report_parser.setup != uni_hid_parser_switch_setup)
+        return;
+    switch_instance_t* ins = get_switch_instance(d);
+    if (!ins->native_owned)
