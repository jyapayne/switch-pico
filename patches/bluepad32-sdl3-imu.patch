+        // Disconnect preserves its bond; lifecycle teardown retires this timer.
+        uni_hid_device_disconnect(d);
+        return;
+    }
+    btstack_run_loop_set_timer(timer, 5);
+    btstack_run_loop_add_timer(timer);
