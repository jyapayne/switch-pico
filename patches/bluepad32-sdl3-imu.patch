+static int32_t wii_calibrate_gyro(const wii_instance_t* ins, int axis, int32_t raw, bool slow) {
+    const uint8_t* c = ins->mp_calibration + (slow ? 16 : 0);
+    int32_t zero = wii_be16(c + 2 * axis);
+    int32_t span = wii_be16(c + 6 + 2 * axis) - zero;
+    int32_t delta = raw * 4 - zero;  // 14-bit sample versus 16-bit factory points.
+    if (span < 0) {
+        span = -span;
+        delta = -delta;
+    }
+    return uni_imu_scale(delta, span, c[12] * 6 * UNI_IMU_GYRO_RES_PER_DEG_S);
+}
