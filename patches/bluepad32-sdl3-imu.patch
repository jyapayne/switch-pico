+static int switch_submit_report(uni_hid_device_t* d, uint16_t cid, uint8_t* report, uint16_t len) {
+    switch_instance_t* ins = get_switch_instance(d);
+    report[2] = ins->packet_num;
+    const int status = l2cap_send(cid, report, len);
+    if (status == ERROR_CODE_SUCCESS) {
