+static void wii_process_motion_extension(uni_hid_device_t* d, const uint8_t* e) {
+    wii_instance_t* ins = get_wii_instance(d);
+    bool accept_extension = ins->state == WII_FSM_LED_UPDATED || ins->state == WII_FSM_MP_VERIFY;
+#if SWITCH_PICO_WII_IR
+    accept_extension = accept_extension || ins->state == WII_FSM_IR_SETUP;
+#endif
+    if (!accept_extension)
+        return;
+    if (!ins->mp_active) {
+        if (ins->ext_type == WII_EXT_NUNCHUK)
+            wii_update_nunchuk(ins, e, false);
+        return;
+    }
+    // Bit zero is reserved in both MP and passthrough frames. In particular,
+    // ignore the FF-filled extension buffer while activation is settling.
+    if (e[5] & 1)
+        return;
+    bool connected = (e[4] & 1) != 0;
+    if (connected != ins->ext_connected) {
+        ins->ext_connected = connected;
+        ins->topology_pending = true;
+        wii_clear_extension(d);
+    }
+    if (!(e[5] & 2)) {
+        if (ins->ext_type == WII_EXT_NUNCHUK && (e[4] & 1))
+            wii_update_nunchuk(ins, e, true);
+        if (ins->topology_pending && ins->state == WII_FSM_LED_UPDATED)
+            wii_discover_extension(d);
+        return;
+    }
