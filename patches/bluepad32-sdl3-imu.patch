+static void switch_discard_queued_rumble(uni_hid_device_t* d) {
+    uni_circular_buffer_t* queue = &d->outgoing_buffer;
+    int read_idx = queue->head_idx;
+    int write_idx = read_idx;
+    for (int n = 0; n < UNI_CIRCULAR_BUFFER_SIZE && read_idx != queue->tail_idx; ++n) {
+        const uni_circular_buffer_data_t* entry = &queue->buffer[read_idx];
+        const bool rumble = entry->cid == d->conn.interrupt_cid &&
+                            entry->data_len >= 2 && entry->data[0] == 0xa2 &&
+                            entry->data[1] == OUTPUT_RUMBLE_ONLY;
+        if (!rumble) {
+            if (write_idx != read_idx)
+                queue->buffer[write_idx] = *entry;
+            write_idx = (write_idx + 1) % UNI_CIRCULAR_BUFFER_SIZE;
+        }
+        read_idx = (read_idx + 1) % UNI_CIRCULAR_BUFFER_SIZE;
+    }
+    queue->tail_idx = write_idx;
