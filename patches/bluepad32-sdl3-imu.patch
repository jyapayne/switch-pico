+    int value = (invert ? -delta : delta) * (AXIS_NORMALIZE_RANGE / 2) / span;
+    if (value < -AXIS_NORMALIZE_RANGE / 2)
+        return -AXIS_NORMALIZE_RANGE / 2;
+    if (value >= AXIS_NORMALIZE_RANGE / 2)
