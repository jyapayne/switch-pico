+static bool wii_read_accel_points(uint16_t zero_points[3], uint16_t spans[3], const uint8_t* c) {
+    // Dolphin WiimoteCommon::AccelCalibrationPoint is shared by the Remote
+    // EEPROM and Nunchuk A40020: XYZ high bytes, then XYZ low bits at 4/2/0.
+    for (int i = 0; i < 3; i++) {
+        int shift = 4 - 2 * i;
+        int zero = (c[i] << 2) | ((c[3] >> shift) & 3);
+        int one = (c[i + 4] << 2) | ((c[7] >> shift) & 3);
+        // Sensitivity is about 100 counts/g (Remote) or 200 (Nunchuk).
+        if (zero == 0 || zero == 1023 || one - zero < 16 || one - zero > 512)
+            return false;
+        zero_points[i] = zero;
+        spans[i] = one - zero;
+    }
+    return true;
+}
