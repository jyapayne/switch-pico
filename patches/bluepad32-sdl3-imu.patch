+static bool wii_read_accel_calibration(wii_instance_t* ins, const uint8_t* c) {
+    uint8_t checksum = 0x55;
+    for (int i = 0; i < 9; i++)
+        checksum += c[i];
+    return checksum == c[9] && wii_read_accel_points(ins->accel_zero, ins->accel_span, c);
